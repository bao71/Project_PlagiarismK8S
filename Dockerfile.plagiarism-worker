FROM python:3.10-slim

WORKDIR /app

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_XET=1 \
    SENTENCE_TRANSFORMER_MODEL=/models/vietnamese-sbert

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    curl \
    poppler-utils \
    libgomp1 \
    libpq-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/plagiarism-worker.txt /app/requirements.txt

RUN python -m pip install --upgrade pip wheel \
    && python -m pip install "setuptools>=67,<82" \
    && python -m pip install -r /app/requirements.txt

RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('keepitreal/vietnamese-sbert').save('/models/vietnamese-sbert')"

COPY app /app/app

RUN python -m py_compile /app/app/worker/plagiarism_worker.py

CMD ["python", "-m", "app.worker.plagiarism_worker"]